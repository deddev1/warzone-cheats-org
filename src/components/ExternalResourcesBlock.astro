---
import type { ExternalResource } from '../data/external-resources';

interface Props {
	title: string;
	lede?: string;
	resources: ExternalResource[];
	ariaLabel?: string;
	compact?: boolean;
}

const { title, lede, resources, ariaLabel = title, compact = false } = Astro.props;
---

{
	resources.length > 0 && (
		<section
			class:list={['ext-resources card-panel', { 'ext-resources--compact': compact }]}
			aria-label={ariaLabel}
		>
			<h2>{title}</h2>
			{lede && <p class="ext-resources__lede">{lede}</p>}
			<ul class="ext-resources__list">
				{resources.map((item) => (
					<li>
						<a href={item.href} target="_blank" rel="noopener noreferrer">
							<span class="ext-resources__source">{item.source}</span>
							<span class="ext-resources__title">{item.title}</span>
							{!compact && <span class="ext-resources__desc">{item.description}</span>}
							<span class="ext-resources__arrow" aria-hidden="true">
								↗
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.ext-resources__lede {
		margin: 0 0 1rem;
		color: var(--ink-muted);
		max-width: 42rem;
		line-height: 1.55;
	}

	.ext-resources__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.ext-resources__list a {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: var(--bg-elevated);
		color: var(--ink);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.ext-resources--compact .ext-resources__list a {
		grid-template-columns: auto 1fr auto;
	}

	.ext-resources__list a:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
		color: var(--magenta-soft);
	}

	.ext-resources__source {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
		white-space: nowrap;
	}

	.ext-resources__title {
		font-weight: 600;
		line-height: 1.35;
	}

	.ext-resources__desc {
		grid-column: 2;
		font-size: 0.85rem;
		color: var(--ink-muted);
		line-height: 1.4;
	}

	.ext-resources__arrow {
		color: var(--ink-faint);
		font-weight: 700;
	}

	@media (max-width: 640px) {
		.ext-resources__list a {
			grid-template-columns: 1fr auto;
			grid-template-rows: auto auto auto;
		}

		.ext-resources__source {
			grid-column: 1 / -1;
		}

		.ext-resources__desc {
			grid-column: 1;
		}
	}
</style>
