---
import HomeAboutApp from './react/HomeAbout';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { heroSrc } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const videoSrc = '/videos/warzone-cheats-demo-480p.mp4';
const videoPoster = heroSrc;
---

<HomeAboutApp client:visible locale={locale} videoSrc={videoSrc} videoPoster={videoPoster} />

<style is:global>
	.home-about {
		padding-block: clamp(2.25rem, 4.5vw, 3.25rem) clamp(1.75rem, 3vw, 2.25rem);
		border-bottom: 1px solid var(--line-soft);
	}

	.home-about__panel {
		padding: clamp(1.35rem, 3vw, 1.85rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(ellipse 80% 60% at 0% 0%, color-mix(in srgb, var(--magenta) 8%, transparent), transparent 55%),
			var(--bg-panel);
	}

	.home-about__layout {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
		grid-template-areas:
			'head video'
			'features video';
		align-items: start;
		gap: clamp(1rem, 2.5vw, 1.5rem) clamp(1.25rem, 3vw, 2rem);
	}

	.home-about__head {
		grid-area: head;
		margin: 0;
		padding-bottom: 0;
		border-bottom: none;
	}

	.home-about__features {
		grid-area: features;
		padding-top: 0.85rem;
		margin-top: 0.15rem;
		border-top: 1px solid var(--line-soft);
	}

	.home-about__media {
		grid-area: video;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		justify-content: center;
		align-self: center;
		min-width: 0;
		position: sticky;
		top: calc(var(--header-h) + 1rem);
	}

	.home-about__video {
		display: block;
		width: 100%;
		max-height: min(22rem, 52vw);
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		background: var(--bg-elevated);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
	}

	.home-about__video-caption {
		margin: 0.55rem 0 0;
		font-size: 0.75rem;
		line-height: 1.45;
		color: var(--ink-faint);
		text-align: center;
	}

	.home-about__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-about__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.8vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.2;
		color: var(--ink);
		max-width: 28ch;
	}

	.home-about__lede {
		margin: 0.65rem 0 0;
		max-width: 42rem;
		font-size: clamp(0.9375rem, 1.5vw, 1.02rem);
		line-height: 1.65;
		color: var(--ink-muted);
	}

	.home-about__features {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-about__features li {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

	.home-about__check {
		flex-shrink: 0;
		width: 1.1rem;
		height: 1.1rem;
		margin-top: 0.12rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--magenta) 18%, var(--bg-elevated));
		border: 1px solid color-mix(in srgb, var(--magenta) 35%, var(--line));
		position: relative;
	}

	.home-about__check::after {
		content: '';
		position: absolute;
		left: 0.34rem;
		top: 0.18rem;
		width: 0.28rem;
		height: 0.48rem;
		border-right: 1.5px solid var(--magenta-soft);
		border-bottom: 1.5px solid var(--magenta-soft);
		transform: rotate(45deg);
	}

	@media (max-width: 900px) {
		.home-about__layout {
			grid-template-columns: 1fr;
			grid-template-areas:
				'head'
				'video'
				'features';
			gap: 1rem;
		}

		.home-about__media {
			position: static;
			align-self: stretch;
		}

		.home-about__video {
			max-height: none;
		}

		.home-about__head {
			padding-bottom: 0.25rem;
		}

		.home-about__features {
			grid-template-columns: 1fr;
			padding-top: 0.35rem;
			border-top: 1px solid var(--line-soft);
		}
	}

	@media (max-width: 480px) {
		.home-about {
			padding-block: 1.75rem 1.35rem;
		}

		.home-about__panel {
			padding: 1.1rem 1rem 1.15rem;
		}

		.home-about__head h2 {
			max-width: none;
		}
	}
</style>
